{
  "name": "traffic-qa-app",
  "version": "1.9.3",
  "description": "Interactive Q&A app for learning Israeli traffic laws",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:headed": "playwright test --headed",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,json,css}\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/generative-ai": "^0.12.0",
    "@supabase/supabase-js": "^2.38.0",
    "axios": "^1.6.2",
    "clsx": "^2.0.0",
    "devkit-console-core": "^0.2.1",
    "devkit-console-ui": "^0.2.1",
    "google-auth-library": "^9.4.1",
    "html2canvas": "^1.4.1",
    "js-cookie": "^3.0.5",
    "jsonwebtoken": "^9.0.2",
    "jspdf": "^4.2.1",
    "jwt-decode": "^4.0.0",
    "mammoth": "^1.12.0",
    "next": "^14.0.0",
    "pdf2json": "^4.0.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwindcss": "^3.3.6",
    "typescript": "^5.3.3",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/js-cookie": "^3.0.6",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@typescript-eslint/eslint-plugin": "^6.11.0",
    "@typescript-eslint/parser": "^6.11.0",
    "@vitest/ui": "^1.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.0",
    "jsdom": "^23.0.1",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "supabase": "^2.109.1",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "optionalDependencies": {
    "@napi-rs/canvas": "^1.0.3"
  }
